# Loads the development shell from nix/ on `cd`. Needs direnv; nix-direnv
# caches the shell. Run `direnv allow` once after cloning or after changing
# this file. Uses the flake when this Nix has flakes, else nix/shell.nix.
if nix flake metadata ./nix >/dev/null 2>&1; then
  use flake ./nix
else
  use nix nix/shell.nix
fi
